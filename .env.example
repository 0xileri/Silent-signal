# Copy to .env for local runs; set these as environment variables when deployed.

# Web app
# PORT=3000
# PUBLIC_URL=http://localhost:3000        # the demo fixture's feeds are read back over HTTP from here
# Bearer token for the operator controls (rotate, revoke, claim, pause). Unset = open (local only).
ADMIN_TOKEN=
# REPO_URL=

# The mission. Defaults to the demo's fictional Project X, whose pages this app serves.
# MISSION_ENTITY=Project X
# MISSION_STATEMENT=Protect Project X from emerging information risks
# MISSION_TERMS=project x,projectx,$prjx
# MISSION_OFFICIAL_URLS=https://status.example.com,https://example.com/blog

# Spend policy: a budget out of the real Orbio balance, a reserve it never touches, a cap per investigation
# MISSION_BUDGET_USD=2
# RESERVE_SHARE=0.2
# MAX_PER_INVESTIGATION_SHARE=0.15
# ANOMALY_CALL_USD=0.05
# ROTATE_AFTER_INVESTIGATION=on
# INVESTIGATION_DEADLINE_SEC=120
# COOLDOWN_HOURS=24
# VERIFIER_MODEL=anthropic/claude-sonnet-5

# Signal thresholds (local and free)
# CLUSTER_SIMILARITY=0.6
# WATCH_THRESHOLD=0.55
# INVESTIGATE_THRESHOLD=0.72

# Schedule. AGENT_SCHEDULE=off disables scheduled scans.
# AGENT_SCHEDULE=on
# SCAN_INTERVAL_MIN=15
# FEED_CACHE_MIN=10
# DEMO_WAVE_DELAY_SEC=12
# DEMO_COOLDOWN_SEC=150

# Telegram alerts (optional): a bot token from @BotFather and the chat to post in
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Where state lives (a mounted volume when deployed)
# DATA_DIR=data
# ORBIO_STATE_DIR=.orbio
# ORBIO_MCP_URL=https://www.orbio.so/api/mcp
